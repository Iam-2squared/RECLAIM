{
  "name": "reclaim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-shiretoko-web.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:preview": "node scripts/standalone.mjs",
    "test:blender": "python3 tests/blender-tools.test.py"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
